class Solution {
public:
    vector<int> dailyTemperatures(vector<int>& t) {
        int n = t.size();
        stack<pair<int,int>> st;
        vector<int> ans(n,0);
        for(int i = n-1;i>=0;i--) {
            while(!st.empty() && st.top().first <= t[i]){
                st.pop();
            }
            int val = (st.empty()) ? 0 : st.top().second - i;
            ans[i]= val;
            st.push({t[i],i});
        }
        return ans;
    }
};

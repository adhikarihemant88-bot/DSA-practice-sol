class Solution {
public:
int getCount(string s) {
    int ans =0;
    for(int i =1;i<s.size();i++) {
        if(s[i] == '1' && s[i-1] == '0') {
            ans++;
        }
    }
    return ans;
}

    int secondsToRemoveOccurrences(string s) {
        int count = getCount(s);
        int ans = 0;
        while(count != 0){
            ans++;
            for(int i=1;i<s.size();i++){
                if(s[i] == '1' && s[i-1] == '0') {
                    swap(s[i],s[i-1]);
                    i++;
                }
            }
            count = getCount(s);
        }
        return ans;
    }
};

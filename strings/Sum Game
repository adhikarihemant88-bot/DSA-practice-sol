class Solution {
public:
    bool sumGame(string num) {
        int n = num.size();
        int l =0; int lSum =0;
        int r =0; int rSum =0;
        for(int i=0;i<n/2;i++) {
            if(num[i] == '?'){
                l++;
                continue;
            }
            int val = num[i] -'0';
            lSum += val;
        }
        for(int i =n/2;i<n;i++) {
            if(num[i] =='?') {
                if(l>0){
                    l--;
                }else{
                    r++;
                }
                continue;
            }
            int val = num[i] - '0';
            rSum += val;
        }
        cout<<lSum <<" "<<rSum<<endl;
        cout<<"diif "<<l<<" "<<r<<endl;
        if((l+r)%2){return true;}
        if(l==0 && r==0 && lSum == rSum){return false;}
        if(l!= 0){
            int val = 9*(l/2);
            if(lSum+val == rSum ){
                return false;
            }
        }
        if(r!=0){
           int val = 9*(r/2);
            if(rSum+val == lSum ){
                return false;
            } 
        }
        return true;
        
    }
};

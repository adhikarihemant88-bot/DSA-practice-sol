class Solution {
public:
    void dfs(vector<vector<char>>& grid,vector<vector<char>>& v,int x,int y) {
        vector<int> nx = {0,0,-1,1};
        vector<int> ny = {1,-1,0,0};
        int m=grid.size();
        int n =grid[0].size();
        v[x][y] = '1';
        for(int i=0;i<4;i++){
            int x1 = x+nx[i];
            int y1 = y +ny[i];
            if(x1>=0 && y1>=0 && x1<m && y1<n && grid[x1][y1] == '1' && v[x1][y1] =='0') {
                dfs(grid,v,x1,y1);
            }
        }
    }

    int numIslands(vector<vector<char>>& grid) {
        int m=grid.size();
        int n =grid[0].size();
        vector<vector<char>> v(m,vector<char>(n,'0'));
        int ans =0;
       
        for(int i =0;i<m;i++) {
            for (int j=0;j<n;j++) {
                if(v[i][j] == '0' && grid[i][j] == '1'){
                    ans++;
                    dfs(grid,v,i,j);
                }
            }
        }
        return ans;
    }
};

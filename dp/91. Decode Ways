class Solution {
public:
    int numDecodings(string s) {
        int n = s.size();
        vector<int> dp(n+1,0);
        dp[0] = 1;
        dp[1] = (s[0] - '0') ? 1:0;
        for(int i =1;i<n;i++) {
            int val1 = s[i] -'0';
            int val2 = (s[i-1] -'0')*10 + val1;
            if(val1 != 0)
                dp[i+1] += dp[i];
            if(val2>=10 && val2<=26){
                dp[i+1] += dp[i-1];
            }
        }
        return dp[n];
    }
}; 

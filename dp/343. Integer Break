class Solution {
public:
    int integerBreak(int n) {
        vector<int> dp(n+1);
        dp[0]= 0;
        dp[1]=1;
        for(int i=2;i<n+1;i++){
            dp[i] = INT_MIN;
            for(int j=1;j<i;j++){
                dp[i] = max(dp[i],j*max(dp[i-j],i-j));
            }
        }
        return dp[n];
    }
};

//greedy
class Solution {
public:
    int integerBreak(int n) {
        if(n==2) return 1;
        if(n==3) return 2;

        int product =1;
        while(n>4) {
            product *= 3;
            n -=3;
        }

        product *= n;
        return product;
    }
};

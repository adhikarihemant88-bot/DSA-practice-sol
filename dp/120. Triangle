class Solution {
public:
    int minimumTotal(vector<vector<int>>& t) {
        int n = t.size();
        for(int i =1;i<n;i++){
            for(int j = 0;j<=i;j++) {
                int val1 = (j>0)? t[i-1][j-1]:INT_MAX;
                int val2 = (j<i)? t[i-1][j]:INT_MAX;
                t[i][j] += min(val1,val2);
            }
        }
         return *min_element(t[n-1].begin(), t[n-1].end());

    }
};

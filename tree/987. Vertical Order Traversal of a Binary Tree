class Solution {
public:
    vector<vector<int>> verticalTraversal(TreeNode* root) {
        if (!root) return {};

        map<int, vector<int>> mp;
        queue<pair<TreeNode*, int>> q;

        q.push({root, 0});

        while (!q.empty()) {
            int n = q.size();
            map<int, vector<int>> level;

            while (n--) {
                auto [temp, ind] = q.front();
                q.pop();

                level[ind].push_back(temp->val);

                if (temp->left)
                    q.push({temp->left, ind - 1});

                if (temp->right)
                    q.push({temp->right, ind + 1});
            }
            for (auto& [col, values] : level) {
                sort(values.begin(), values.end());

                for (int val : values) {
                    mp[col].push_back(val);
                }
            }
        }

        vector<vector<int>> ans;

        for (auto& [col, values] : mp) {
            ans.push_back(values);
        }

        return ans;
    }
};

//DFS
class Solution {
public:
    vector<vector<int>> verticalTraversal(TreeNode* root) {
        vector<tuple<int, int, int>> nodes;  // (col, row, val)
        dfs(root, 0, 0, nodes);

        sort(nodes.begin(), nodes.end());

        vector<vector<int>> res;
        int prevCol = INT_MIN;

        for (auto [col, row, val] : nodes) {
            if (col != prevCol) {
                res.push_back({});
                prevCol = col;
            }
            res.back().push_back(val);
        }

        return res;
    }

    void dfs(TreeNode* node, int row, int col, vector<tuple<int, int, int>>& nodes) {
        if (!node) return;
        nodes.emplace_back(col, row, node->val);
        dfs(node->left, row + 1, col - 1, nodes);
        dfs(node->right, row + 1, col + 1, nodes);
    }
};

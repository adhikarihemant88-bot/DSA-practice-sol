class Solution {
public:
    vector<vector<int>> verticalTraversal(TreeNode* root) {
        if (!root) return {};

        map<int, vector<int>> mp;
        queue<pair<TreeNode*, int>> q;

        q.push({root, 0});

        while (!q.empty()) {
            int n = q.size();
            map<int, vector<int>> level;

            while (n--) {
                auto [temp, ind] = q.front();
                q.pop();

                level[ind].push_back(temp->val);

                if (temp->left)
                    q.push({temp->left, ind - 1});

                if (temp->right)
                    q.push({temp->right, ind + 1});
            }
            for (auto& [col, values] : level) {
                sort(values.begin(), values.end());

                for (int val : values) {
                    mp[col].push_back(val);
                }
            }
        }

        vector<vector<int>> ans;

        for (auto& [col, values] : mp) {
            ans.push_back(values);
        }

        return ans;
    }
};

class Solution {
public:
    string shortestBeautifulSubstring(string s, int k) {
        int st = 0;
        int count = 0;
        string ans = "";
        for (int i = 0; i < s.size(); i++) {
            if (s[i] == '1') {
                count++;
            }
            while (count > k) {
                if (s[st] == '1') {
                    count--;
                }
                st++;
            }

            if (count == k) {
                while (st <= i && s[st] == '0') {
                    st++;
                }

                string temp = s.substr(st, i - st + 1);

                if (ans == "" ||
                    temp.size() < ans.size() ||
                    (temp.size() == ans.size() && temp < ans)) {

                    ans = temp;
                }
            }
        }

        return ans;
    }
};

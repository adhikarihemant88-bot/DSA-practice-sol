class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
       int st = -1;
        int zeros = 0;
        int ans = 0;
        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] == 0)
                zeros++;
            while (st<i && zeros > k) {
                st++;
                if (nums[st] == 0)
                    zeros--;
            }
            ans = max(ans, i - st);
        }
        return ans; 
    }

};

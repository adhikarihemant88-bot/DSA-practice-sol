class Solution {
public:
        bool check(int mid, vector<int>& piles,int time){

        long long ans=0;
        for(int i=0;i<piles.size();i++){
            ans += ceil((double)piles[i] / mid);
        }

        return ans<=time ? true :false;
        
    }

    int minEatingSpeed(vector<int>& piles, int h) {
        int low = 1;
        int high = *max_element(piles.begin(),piles.end()); 
        int ans =-1;
        //cout<<high<<endl;

        while(low <=high) {
            int mid = low + (high-low)/2;

            if(check(mid,piles,h)){
                ans = mid;
                high = mid - 1;
            } else {
                low = mid+1;
            }
        }

        return ans;
    }
};

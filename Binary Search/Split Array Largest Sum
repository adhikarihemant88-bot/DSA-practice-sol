class Solution {
private:
    bool check(vector<int>&v, int mid, int k) {
        int val =1;
        int sum =0;
        for(auto it: v) {
            sum += it;
            if(sum>mid){
                val++;
                sum = it;
            }
            if(val>k){
                break;
            }
        }
        bool ans =  (val>k) ? false : true;
        //cout<<val<<" mid " <<mid<< " ans "<< ans<<endl;
        return ans;
    }
public:
    int splitArray(vector<int>& nums, int k) {
        int sum = 0;
        for(auto it: nums) {
            sum +=it;
        }
        int l= *max_element(nums.begin(),nums.end());
        int r = sum;
        int ans =0;
        while(l<=r) {
            int mid = l + (r-l)/2;
            if(check(nums,mid,k)) {
                ans = mid;
                r = mid-1;
            }else{
                l =mid+1;
            }
        }
        return ans;
    }
};

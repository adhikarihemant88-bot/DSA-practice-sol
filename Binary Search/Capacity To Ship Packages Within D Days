class Solution {
public:
    bool isShipped(int weight, int days, vector<int> weights) {
        int day = 1;
        int sum = 0;
        for (int i = 0; i < weights.size(); i++) {
            sum += weights[i];
            if (sum > weight) {
                day++;
                sum = weights[i];
            }
        }
        return (day <= days);
    }
    int shipWithinDays(vector<int>& weights, int days) {
        int start = *max_element(weights.begin(),weights.end());
        int ans = 0;
        int end = accumulate(weights.begin(),weights.end(),0);
        while (start <= end) {
            int mid = start + (end - start) / 2;
            if (isShipped(mid, days, weights)) {
                ans = mid;
                end = mid - 1;
            } else {
                start = mid + 1;
            }
        }
        return ans;
    }
};
